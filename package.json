  "scripts": {
    "dev": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run format:check",
    "build": "npm run typecheck && node -e \"require('node:fs').copyFileSync('LICENSE', 'public/LICENSE')\" && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node scripts/start.mjs",
    "init": "node scripts/start.mjs --ensure-only"
  },
  "dependencies": {},
  "devDependencies": {
    "vite": "8.3.2",
    "typescript": "7.0.2",
    "prettier": "3.9.9"
